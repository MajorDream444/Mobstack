{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MobStack Agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "mob",
    "purpose",
    "inputs",
    "outputs",
    "neverDoes",
    "humanOwner",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mob": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "neverDoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "humanOwner": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
