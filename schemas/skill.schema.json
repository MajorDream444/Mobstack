{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MobStack Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "purpose",
    "trigger",
    "context",
    "procedure",
    "outputs",
    "gates",
    "owner",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  }
}
